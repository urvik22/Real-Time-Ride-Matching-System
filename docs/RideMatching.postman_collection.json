{
  "info": {
    "name": "Real-Time Ride Matching API",
    "description": "Driver availability and complete ride lifecycle. Swagger UI: http://localhost:5073/swagger",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5073" },
    { "key": "driverId", "value": "11111111-1111-1111-1111-111111111111" },
    { "key": "riderId", "value": "22222222-2222-2222-2222-222222222222" },
    { "key": "rideId", "value": "33333333-3333-3333-3333-333333333333" }
  ],
  "item": [
    {
      "name": "System",
      "item": [
        { "name": "Health", "request": { "method": "GET", "url": "{{baseUrl}}/health" } },
        { "name": "Active storage provider", "request": { "method": "GET", "url": "{{baseUrl}}/api/system/storage" } },
        { "name": "Swagger JSON", "request": { "method": "GET", "url": "{{baseUrl}}/swagger/v1/swagger.json" } }
      ]
    },
    {
      "name": "Drivers",
      "item": [
        {
          "name": "Go online",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"latitude\": 12.9717,\n  \"longitude\": 77.5947\n}" },
            "url": "{{baseUrl}}/api/drivers/{{driverId}}/online"
          }
        },
        {
          "name": "Update location",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"latitude\": 12.9718,\n  \"longitude\": 77.5948\n}" },
            "url": "{{baseUrl}}/api/drivers/{{driverId}}/location"
          }
        },
        { "name": "Get driver", "request": { "method": "GET", "url": "{{baseUrl}}/api/drivers/{{driverId}}" } },
        { "name": "Go offline", "request": { "method": "PUT", "url": "{{baseUrl}}/api/drivers/{{driverId}}/offline" } }
      ]
    },
    {
      "name": "Rides",
      "item": [
        {
          "name": "Create ride",
          "event": [{
            "listen": "test",
            "script": { "exec": ["const body = pm.response.json();", "if (body.id) pm.collectionVariables.set('rideId', body.id);"] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"riderId\": \"{{riderId}}\",\n  \"pickup\": { \"latitude\": 12.9716, \"longitude\": 77.5946 },\n  \"destination\": { \"latitude\": 12.9352, \"longitude\": 77.6245 }\n}" },
            "url": "{{baseUrl}}/api/rides"
          }
        },
        { "name": "Get ride", "request": { "method": "GET", "url": "{{baseUrl}}/api/rides/{{rideId}}" } },
        {
          "name": "Start ride",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"driverId\": \"{{driverId}}\" }" },
            "url": "{{baseUrl}}/api/rides/{{rideId}}/start"
          }
        },
        {
          "name": "Complete ride",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"driverId\": \"{{driverId}}\" }" },
            "url": "{{baseUrl}}/api/rides/{{rideId}}/complete"
          }
        },
        { "name": "Cancel ride", "request": { "method": "POST", "url": "{{baseUrl}}/api/rides/{{rideId}}/cancel" } }
      ]
    }
  ]
}
