@host = http://localhost:5073
@driverId = 11111111-1111-1111-1111-111111111111
@riderId = 22222222-2222-2222-2222-222222222222

### Driver goes online
PUT {{host}}/api/drivers/{{driverId}}/online
Content-Type: application/json

{ "latitude": 12.9717, "longitude": 77.5947 }

### Create ride (copy the returned id into rideId below)
POST {{host}}/api/rides
Content-Type: application/json

{
  "riderId": "{{riderId}}",
  "pickup": { "latitude": 12.9716, "longitude": 77.5946 },
  "destination": { "latitude": 12.9352, "longitude": 77.6245 }
}

### Check ride
@rideId = 33333333-3333-3333-3333-333333333333
GET {{host}}/api/rides/{{rideId}}

### Driver starts ride
POST {{host}}/api/rides/{{rideId}}/start
Content-Type: application/json

{ "driverId": "{{driverId}}" }

### Driver completes ride
POST {{host}}/api/rides/{{rideId}}/complete
Content-Type: application/json

{ "driverId": "{{driverId}}" }
